# Copy to .env to override the local defaults in docker-compose.yml.
# Values here are placeholders for local development only.

# Host ports published by docker-compose
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL container
POSTGRES_USER=booking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=booking

# API (used when running outside docker: npm run dev / npm test)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://booking:change_me@localhost:5432/booking
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Authentication. JWT_SECRET must be at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=3600

# First admin account, created at startup if no user with this email exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin

# Rate limiting (Redis). Set to false for load tests that send everything from one address.
RATE_LIMIT_ENABLED=true
# Set to true only behind a reverse proxy that sets X-Forwarded-For; otherwise clients
# could forge the header to get around per-IP limits.
TRUST_PROXY=false
