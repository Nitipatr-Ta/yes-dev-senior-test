# Copy to .env to override the local defaults in docker-compose.yml.
# Values here are placeholders for local development only.

# Host ports published by docker-compose
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL container
POSTGRES_USER=booking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=booking

# API (used when running outside docker: npm run dev / npm test)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://booking:change_me@localhost:5432/booking
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
